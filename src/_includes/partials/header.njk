<a href="#main" class="skip-to-content contrast" role="button">{{ meta.skipContent }}</a>
<header class="container">
  <hgroup>
    <h1>{{ meta.siteName }}{{ meta.siteName2 }}</h1>
    <p>{{ meta.tagLine }}</p>
  </hgroup>
  <nav>
    <ul>
    {% for item in navigation.top %}
      <li><a href="{{ item.url }}">{{ item.text }}</a></li>
    {% endfor %}
    </ul>
  </nav>
</header>