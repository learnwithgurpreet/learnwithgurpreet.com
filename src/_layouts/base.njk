<!doctype html>
<html lang="{{ meta.lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {% if discover.title %}
        {{ discover.title }}
      {% elif title %}
        {{ title }}
      {% else %}
        {{ meta.siteName }}{{ meta.siteName2 }}
      {% endif %}
    </title>
    <style>
      :root {
        --lightLink: #de0059;
        --darkLink: #ffb3d8;
        --lightFont: #222222;
        --darkFont: #e9e9e9;
        --lightBackground: #fff;
        --darkBackground: #222222;
        --codeBgColor: #191d27;
        --codeColor: #d6d9e0;
        --link-color: var(--lightLink);
        --bg-color: var(--lightBackground);
        --font-color: var(--lightFont);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --link-color: var(--darkLink);
          --bg-color: var(--darkBackground);
          --font-color: var(--darkFont);
        }
      }
      body {
        font-family: "Times New Roman", monospace;
        background-color: var(--bg-color);
        font-size: 20px;
        line-height: 1.5;
        color: var(--font-color);
        overflow-y: scroll;
        margin: 0;
        padding: 2rem 0;
      }
      .logo {
        display: flex;
      }
      .logo:after {
        content: ' ';
        background: repeating-linear-gradient(90deg, var(--link-color), var(--link-color) 2px, transparent 0, transparent 10px);
        display: block;
        width: 100%;
      }
      .logo a {
        flex: 0 0 auto;
        max-width: 100%;
        text-decoration: none;
      }
      .logo a div {
        display: flex;
        align-items: center;
        text-decoration: none;
        background: var(--link-color);
        color: var(--bg-color);
        padding: 0.5rem 1rem;
        font-weight: bold;
        unicode-bidi: isolate;
        font-size: 1.5rem;
        text-transform: uppercase;
        letter-spacing: .04em;
      }
      nav {
        margin: 1rem 0;
      }
      nav ul,
      nav ol {
        display: flex;
        flex-wrap: wrap;
        column-gap: 1rem;
        margin: 0;
        padding: 0;
      }
      nav ul > li,
      nav ol > li {
        flex: 0 0 auto;
        margin-bottom: 0.5rem;
        white-space: nowrap;
      }
      .feature {
        display: block;
        text-align: center;
      }
      img {
        max-width: 100%;
        height: auto;
      }
      header {
        max-width: 900px;
        margin: 0 auto;
        padding: 0px 1rem;
      }
      main,
      footer {
        margin: 0px auto;
        max-width: 900px;
        padding: 0px 1rem;
      }
      nav ul,
      nav ol {
        list-style: none;
        padding: 0;
      }
      nav ul li,
      nav ol li {
        display: inline-block;
      }
      time {
        font-style: italic;
        color: var(--font-color);
        opacity: 0.8;
      }
      .blog-list {
        display: flex; 
        flex-direction: column; 
        gap: 1rem;
      }
      .blog-list article {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
      }
      .blog-list h2 {
        display: inline-block;
        margin: 0;
        padding: 0;
      }
      .blog-list p {
        padding-top: 0.25rem;
        margin: 0;
      }
      @font-face {
        font-family: 'FontWithASyntaxHighlighterLightOwl-Regular';
        src:
          url('/assets/fonts/FontWithASyntaxHighlighterLightOwl-Regular.woff2')
          format('woff2')
        ;
      }
      code {
        font-family: "FontWithASyntaxHighlighterLightOwl-Regular", monospace;
        color: var(--codeColor);
        background-color: var(--codeBgColor);
      }
      pre:has(code) {
        line-height: 1.5rem;
        padding: 1rem 2rem;
        overflow-x: auto;
        background-color: var(--codeBgColor);
        border-radius: 0.5rem;
      }
      a {
        text-decoration: none;
        color: var(--link-color);
      }
      a[aria-current="page"] {
        color: var(--font-color);
      }
      a:hover {
        text-decoration: underline;
      }
      blockquote {
        font-style: italic;
        padding-left: .8em;
        margin-left: .5em;
        border-left: 2px solid #cdcdcd;
      }
      .headline h1 {
        margin: 0;
      }
      .headline {
        margin-bottom: 2.5rem;
      }
      .footnotes {
        font-size: 80%;
      }
      .skip-to-content {
        z-index: 999;
        position: absolute;
        top: 0;
        left: 0;
        transform: translateY(-1000%);
        opacity: 0;
      }
      .skip-to-content:focus {
        transform: translateY(0);
        opacity: 1;
      }
      summary {
        cursor: pointer;
        padding: 0.5rem 0;
      }
      table {
        border-collapse: collapse;
        margin: 25px 0;
        font-size: 0.9em;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
        width: 100%;
      }
      table thead tr {
        background-color: var(--lightLink);
        color: #ffffff;
        text-align: left;
      }
      table th,
      table td {
        padding: 12px 15px;
      }
      table tbody tr {
        border-bottom: 1px solid var(--lightLink);
        color: var(--font-color);
      }
      table tbody tr:nth-of-type(even) {
        background-color: #e9e9e9;
        color: var(--lightFont);
      }
      table tbody tr:last-of-type {
        border-bottom: 2px solid var(--lightLink);
      }
    </style>
    {% include "schemas/base-schema.njk" %}

    {% if schema == 'blog' %}{%- include "schemas/blogpost-schema.njk" -%}{% endif %}

    <!-- everything else: meta tags, icons, open graph etc.  -->
    {% include "partials/meta-info.njk" %}
  </head>
  <body>
    {% include "partials/header.njk" %}
    <main id="main">{{ content | safe }}</main>
    {% include "partials/footer.njk" %}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="5f065192-b2a1-46ea-82ae-3d5f72b17d79"></script>
  </body>
</html>
