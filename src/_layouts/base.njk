<!doctype html>
<html lang="{{ meta.lang }}">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {% if discover.title %}
    {{ discover.title }}
    {% elif title %}
    {{ title }}
    {% else %}
    {{ meta.blog.name }}
    {% endif %}
  </title>
  <style>
    :root {
      --bg: #fcf6ef;
      --text: #0D0D0D;
      --accent: #c14d00;
      --border: #2C2C2C;
      --accent-bg: #f8e1cc;
      --standard-border: 1px solid var(--border);
      --font: "Times New Roman", monospace;
      --code-font: monospace;
      --content-max: min(100% - 2rem, 75rem);
      --radius: 0.5rem;
      color-scheme: light;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0D0D0D;
        --text: #DCDCDC;
        --accent: #FF7518;
        --border: #555;
        --accent-bg: #2C2C2C;
        color-scheme: dark;
      }
    }

    body {
      font-family: var(--font);
      background-color: var(--bg);
      font-size: 20px;
      line-height: 1.5;
      color: var(--text);
      overflow-y: scroll;
      margin: 0;
      padding: 2rem 0;
    }

    .logo {
      display: flex;
    }

    .logo:after {
      content: ' ';
      background: repeating-linear-gradient(90deg, var(--accent), var(--accent) 2px, transparent 0, transparent 10px);
      display: block;
      width: 100%;
    }

    .logo a {
      flex: 0 0 auto;
      max-width: 100%;
      text-decoration: none;
    }

    .logo a div {
      display: flex;
      align-items: center;
      text-decoration: none;
      background: var(--accent);
      color: var(--bg);
      padding: 0.5rem 1rem;
      font-weight: bold;
      unicode-bidi: isolate;
      font-size: 1.5rem;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    nav {
      margin: 1rem 0;
    }

    nav ul,
    nav ol {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1rem;
      margin: 0;
      padding: 0;
    }

    nav ul>li,
    nav ol>li {
      flex: 0 0 auto;
      margin-bottom: 0.5rem;
      white-space: nowrap;
    }

    .feature {
      display: block;
      text-align: center;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    header {
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 0px 1rem;
    }

    main,
    footer {
      margin: 0px auto;
      max-width: var(--content-max);
      padding: 0px 1rem;
    }

    nav ul,
    nav ol {
      list-style: none;
      padding: 0;
    }

    nav ul li,
    nav ol li {
      display: inline-block;
    }

    time {
      font-style: italic;
      color: var(--text);
      opacity: 0.8;
    }

    .blog-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .blog-list article {
      display: flex;
      flex-direction: column;
      padding: 1rem 0;
    }

    .blog-list h2 {
      display: inline-block;
      margin: 0;
      padding: 0;
    }

    .blog-list p {
      padding-top: 0.25rem;
      margin: 0;
    }

    code {
      font-family: var(--code-font);
      font-size: 90%;
      background-color: var(--accent-bg);
      padding: 0 0.2em;
    }

    pre:has(code) {
      line-height: 1.5rem;
      padding: 0.5rem 1em;
      overflow-x: auto;
      background-color: var(--accent-bg);
      border-radius: var(--radius);
    }

    a {
      text-decoration: none;
      color: var(--accent);
    }

    a[aria-current="page"] {
      color: var(--text);
    }

    a:hover {
      text-decoration: underline;
    }

    blockquote {
      font-style: italic;
      padding-left: .8em;
      margin-left: .5em;
      border-left: var(--standard-border);
    }

    .headline h1 {
      margin: 0;
    }

    .headline {
      margin-bottom: 2.5rem;
    }

    .header-anchor {
      text-decoration: none;
      font-size: 0.80em;
      margin-left: 0.15em;
    }

    .footnotes {
      font-size: 80%;
    }

    /* TOC Styles */
    .post-wrapper {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    @media (min-width: 768px) {
      .post-wrapper {
        flex-direction: row;
        align-items: flex-start;
      }

      .post-wrapper nav.toc {
        flex: 0 0 250px;
        position: sticky;
        top: 2rem;
        max-height: calc(100vh - 4rem);
        overflow-y: auto;
        background-color: transparent;
        padding: 0;
      }

      .post-wrapper #post-content {
        flex: 1;
        min-width: 0;
        order: 1;
      }

      .post-wrapper .toc li {
        border-left: 2px solid transparent;
      }

      .post-wrapper .toc li:has(.is-current) {
        border-left-color: var(--accent);
      }

      .post-wrapper .toc h2 {
        padding-left: 1rem;
      }
    }

    nav.toc {
      border-left: var(--standard-border);
      font-size: 0.95rem;
      background-color: var(--accent-bg);
      padding: 1rem;
    }

    nav.toc h2 {
      margin-top: 0;
    }

    nav.toc ol {
      list-style: none;
      padding-left: 0;
      margin: 0;
      display: grid;
    }

    nav.toc ol ol {
      padding-left: 1rem;
      margin-top: 0.5rem;
    }

    nav.toc li {
      margin-bottom: 0.5rem;
      line-height: 1.4;
      white-space: wrap;
      padding-left: 1rem;
    }

    nav.toc a {
      color: var(--text);
      display: block;
      transition: color 0.2s;
    }

    nav.toc a:hover {
      color: var(--accent);
    }

    nav.toc a.is-current {
      color: var(--accent);
      font-weight: bold;
    }

    .skip-to-content {
      z-index: 999;
      position: absolute;
      top: 0;
      left: 0;
      transform: translateY(-1000%);
      opacity: 0;
    }

    .skip-to-content:focus {
      transform: translateY(0);
      opacity: 1;
    }

    summary {
      cursor: pointer;
      padding: 0.5rem 0;
    }

    table {
      border-collapse: collapse;
      margin: 25px 0;
      font-size: 0.9em;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
      border: var(--standard-border);
      width: 100%;
    }

    table thead tr {
      text-align: left;
    }

    table th,
    table td {
      padding: 12px 15px;
    }

    table tbody tr {
      border: var(--standard-border);
      color: var(--text);
    }
  </style>
  {% include "schemas/base-schema.njk" %}

  {% if schema == 'blog' %}{%- include "schemas/blogpost-schema.njk" -%}{% endif %}

  <!-- everything else: meta tags, icons, open graph etc.  -->
  {% include "partials/meta-info.njk" %}
</head>

<body>
  {% include "partials/header.njk" %}
  <main id="main">{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script>
    // TOC scroll highlighting
    (function () {
      const toc = document.querySelector('nav.toc');
      if (!toc) return;

      const tocLinks = toc.querySelectorAll('a[href^="#"]');
      const headings = Array.from(tocLinks).map(link => {
        const id = link.getAttribute('href').substring(1);
        return document.getElementById(id);
      }).filter(Boolean);

      if (headings.length === 0) return;

      function updateActiveLink() {
        // Find the current heading based on scroll position
        let current = null;
        const scrollPosition = window.scrollY + 100; // Offset for better UX

        for (let i = headings.length - 1; i >= 0; i--) {
          const heading = headings[i];
          if (heading.offsetTop <= scrollPosition) {
            current = heading;
            break;
          }
        }

        // Remove is-current from all links
        tocLinks.forEach(link => link.classList.remove('is-current'));

        // Add is-current to the active link
        if (current) {
          const activeLink = toc.querySelector(`a[href="#${current.id}"]`);
          if (activeLink) {
            activeLink.classList.add('is-current');
          }
        }
      }

      // Throttle scroll events for performance
      let ticking = false;
      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateActiveLink();
            ticking = false;
          });
          ticking = true;
        }
      }

      // Listen to scroll events
      window.addEventListener('scroll', onScroll, { passive: true });

      // Initial check
      updateActiveLink();
    })();
  </script>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="5f065192-b2a1-46ea-82ae-3d5f72b17d79"></script>
</body>

</html>