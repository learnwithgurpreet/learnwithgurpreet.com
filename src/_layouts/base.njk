<!doctype html>
<html lang="{{ meta.lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {% if discover.title %}
        {{ discover.title }}
      {% elif title %}
        {{ title }}
      {% else %}
        {{ meta.siteName }}{{ meta.siteName2 }}
      {% endif %}
    </title>
    <style>
      :root {
        --lightLink: #de0059;
        --darkLink: #ffb3d8;
        --lightFont: #222222;
        --darkFont: #e9e9e9;
        --lightBackground: #fff;
        --darkBackground: #222222;
        --codeBgColor: #191d27;
        --codeColor: #d6d9e0;
        --link-color: var(--lightLink);
        --bg-color: var(--lightBackground);
        --font-color: var(--lightFont);
        --code-color: var(--lightCode);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --link-color: var(--darkLink);
          --bg-color: var(--darkBackground);
          --font-color: var(--darkFont);
          --code-color: var(--darkCode);
        }
      }
      body {
        font-family: "Times New Roman", monospace;
        background-color: var(--bg-color);
        font-size: 20px;
        line-height: 1.5;
        color: var(--font-color);
        overflow-y: scroll;
        margin: 0;
        padding: 2rem 0;
      }
      img {
        max-width: 100%;
        height: auto;
      }
      header {
        max-width: 900px;
        margin: 0 auto;
        padding: 0px 1rem;
      }
      main,
      footer {
        margin: 0px auto;
        max-width: 900px;
        padding: 0px 1rem;
      }
      nav ul,
      nav ol {
        list-style: none;
        padding: 0;
      }
      nav ul li,
      nav ol li {
        display: inline-block;
        margin-right: 1rem;
      }
      time {
        font-style: italic;
        color: var(--font-color);
        opacity: 0.8;
      }
      .blog-list {
        display: flex; 
        flex-direction: column; 
        gap: 1rem;
      }
      .blog-list article {
        padding: 1rem 0;
      }
      .blog-list h2 {
        margin: 0;
        padding: 0;
      }
      .blog-list p {
        padding-top: 0.25rem;
        margin: 0;
      }
      @font-face {
        font-family: 'FontWithASyntaxHighlighterLightOwl-Regular';
        src:
          url('/assets/fonts/FontWithASyntaxHighlighterLightOwl-Regular.woff2')
          format('woff2')
        ;
      }
      code {
        font-family: "FontWithASyntaxHighlighterLightOwl-Regular", monospace;
        color: var(--codeColor);
        background-color: var(--codeBgColor);
      }
      pre:has(code) {
        line-height: 1.5rem;
        padding: 1rem 2rem;
        overflow-x: auto;
        background-color: var(--codeBgColor);
        border-radius: 0.5rem;
      }
      a {
        text-decoration: none;
        color: var(--link-color);
        font-size: 1.2rem;
      }
      a[aria-current="page"] {
        color: var(--font-color);
      }
      a:hover {
        text-decoration: underline;
      }
      blockquote {
        font-style: italic;
        padding-left: .8em;
        margin-left: .5em;
        border-left: 2px solid #cdcdcd;
      }
      .headline h1 {
        margin: 0;
      }
      .headline {
        margin-bottom: 2.5rem;
      }
      .footnotes {
        font-size: 80%;
      }
      .skip-to-content {
        z-index: 999;
        position: absolute;
        top: 0;
        left: 0;
        transform: translateY(-1000%);
        opacity: 0;
      }
      .skip-to-content:focus {
        transform: translateY(0);
        opacity: 1;
      }
      summary {
        cursor: pointer;
        padding: 0.5rem 0;
      }
    </style>
    {% include "schemas/base-schema.njk" %}

    {% if schema == 'blog' %}{%- include "schemas/blogpost-schema.njk" -%}{% endif %}

    <!-- everything else: meta tags, icons, open graph etc.  -->
    {% include "partials/meta-info.njk" %}
  </head>
  <body>
    {% include "partials/header.njk" %}
    <main id="main">{{ content | safe }}</main>
    {% include "partials/footer.njk" %}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="5f065192-b2a1-46ea-82ae-3d5f72b17d79"></script>
  </body>
</html>
